################### Routelogbeat Configuration Example #########################

############################# Routelogbeat ######################################

routelogbeat:
  # Tags to cache terminal data meta by destination
  destinations:
    - "IPAN"
    - "MES"
    
  # Tags to cache terminal data meta by source
  sources:
    - "SOURCE"

  # Tags for slab terminal data cache
  physical_route_tags:
    - "SLAB"

  # (optional) Nameset to select from for the "source" and "destination", value and default value for emptry route
  mapping:
    nameset: "Broadview"
    default: ""

  # Magnum API
  api:
    url: "https://129.213.88.5/graphql/v1.1"
    
    # Get route notifications via the subscriptions
    notifications: true

    # Limit the number of destinations in the API query results
    limit: 500
    
    # Magnum OIDC Authentication
    auth:
      client_id: "insite-poller"
      client_secret: "gpJ2WSbjBOD1HoZxpTYGaqKdqeBD1mll"
      token_url: "https://129.213.88.5/auth/realms/magnum/protocol/openid-connect/token"

  # RabbitMQ client configuration
  rabbitmq_client:
    host: "localhost"
    port: 8910
    vhost: "/"
    username: "insite"
    password: "abacus"
    exchange: "x.routelogbeat.logs"
    queue: "q.routelogbeat.logs"
    routing_key: "log.data"

  # Correlation engine: groups related route log lines into timed event envelopes.
  correlator:
    # Which log kind opens a new envelope:
    #   "scheduler" | "magnum_subscribe" | "magnum_complete"
    open_on: "scheduler"

    # How long after the opening log an envelope stays open before it is
    # closed and dispatched. The event duration is measured across this window.
    close_after: 2m

    # How often expired envelopes are swept and dispatched.
    sweep_interval: 1s

    # Safety cap on simultaneously open envelopes.
    max_open: 4096

    # How long a slab/magrtrsrv log whose destination isn't in the lookup map
    # yet waits for it to catch up before it is dropped.
    pending_wait: 5s

    # Only correlate routes whose destination is in the destination metadata
    # cache (built from the destination tags); routes to any other destination
    # are discarded before an envelope is opened.
    require_dst_metadata: false

    # Close an envelope early, with reason "complete", once every slab in the
    # destination's slab list has logged, instead of always waiting for
    # close_after. close_after still closes routes where a slab never logs.
    close_on_complete: false

    # With close_on_complete, how long a complete envelope stays open for
    # late logs (e.g. a magrtrsrv log after its slab log) before it closes.
    complete_grace: 2s